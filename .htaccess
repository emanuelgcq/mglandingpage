# ───────────────────────────────────────────────────────────
#  Materiales y Decoraciones MG — configuración de Apache
#  (Hostinger usa Apache, así que este archivo se aplica solo)
# ───────────────────────────────────────────────────────────

# Bloquea el acceso al repositorio y a archivos de desarrollo.
# Sin esto, https://tudominio.com/.git/config sería público.
RedirectMatch 404 /\.git
RedirectMatch 404 /\.htaccess
<FilesMatch "^(README\.md|\.gitignore|\.gitattributes)$">
  Require all denied
</FilesMatch>

# La portada
DirectoryIndex index.html

# No listar el contenido de las carpetas
Options -Indexes

# ───── Compresión ─────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ───── Caché del navegador ─────
# El HTML no se cachea para que los cambios de texto se vean enseguida.
# CSS y JS, un día: no llevan versión en el nombre, así que una caché
# larga dejaría a los visitantes con la hoja de estilos vieja.
# Si necesitas forzar una actualización inmediata, cambia el enlace en
# index.html a styles.css?v=2 (y sube el número en cada cambio).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 day"
  ExpiresByType application/javascript  "access plus 1 day"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ───── Tipos MIME ─────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

# ───── Errores ─────
ErrorDocument 404 /index.html
